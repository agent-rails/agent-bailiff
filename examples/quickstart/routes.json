{
  "routes": [
    {"service": "gitea", "name": "list_issues", "tool": "gitea.issues.list", "resource": "gitea/repos/{owner}/{repo}/issues", "schema": [{"name": "owner", "kind": "identifier"}, {"name": "repo", "kind": "identifier"}]},
    {"service": "gitea", "name": "issue_read", "tool": "gitea.issues.read", "resource": "gitea/repos/{owner}/{repo}/issues", "schema": [{"name": "owner", "kind": "identifier"}, {"name": "repo", "kind": "identifier"}]},
    {"service": "gitea", "name": "get_file_contents", "tool": "gitea.contents.read", "resource": "gitea/repos/{owner}/{repo}/contents", "schema": [{"name": "owner", "kind": "identifier"}, {"name": "repo", "kind": "identifier"}]}
  ]
}
