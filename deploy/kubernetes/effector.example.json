          },
          {
            "expression": "object.metadata.?uid == oldObject.metadata.?uid",
            "message": "a restart may not change metadata.uid"
          },
          {
            "expression": "variables.annotations.all(k, k == 'kubectl.kubernetes.io/restartedAt' || (k in variables.previous && variables.previous[k] == variables.annotations[k])) && variables.previous.all(k, k == 'kubectl.kubernetes.io/restartedAt' || k in variables.annotations)",
