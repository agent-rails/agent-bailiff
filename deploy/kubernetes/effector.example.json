            "message": "a restart may not change spec.selector"
          },
          {
            "expression": "object.spec.?strategy == oldObject.spec.?strategy",
            "message": "a restart may not change spec.strategy"
          },
          {
            "expression": "object.spec.template.spec == oldObject.spec.template.spec",
            "message": "a restart may not change the pod spec"
          },
          {
            "expression": "object.spec.template.metadata.?creationTimestamp == oldObject.spec.template.metadata.?creationTimestamp",
            "message": "a restart may not change spec.template.metadata.creationTimestamp"
          },
          {
            "expression": "object.spec.template.metadata.?deletionGracePeriodSeconds == oldObject.spec.template.metadata.?deletionGracePeriodSeconds",
            "message": "a restart may not change spec.template.metadata.deletionGracePeriodSeconds"
          },
