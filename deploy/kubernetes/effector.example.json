        "validationActions": [
          "Deny"
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "agent-bailiff",
          "bailiff.dev/generated": "true"
        },
        "name": "bailiff-effector-rbac"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                "rbac.authorization.k8s.io"
              ],
              "apiVersions": [
                "*"
              ],
              "operations": [
                "CREATE",
                "UPDATE"
              ],
              "resources": [
                "rolebindings",
                "clusterrolebindings",
                "roles",
                "clusterroles"
              ]
            }
          ]
        },
        "validations": [
          {
            "expression": "(!(has(object.subjects) && object.subjects.exists(s, (s.kind == 'ServiceAccount' && s.namespace == 'bailiff-system' && (s.name == 'effector' || s.name == 'effector-audit')) || (s.kind == 'User' && s.name.startsWith('bailiff:')))) && !(has(object.metadata.labels) && 'bailiff.dev/generated' in object.metadata.labels) && !(oldObject != null && (has(oldObject.metadata.labels) && 'bailiff.dev/generated' in oldObject.metadata.labels))) || request.userInfo.username == 'system:serviceaccount:argocd:argocd-application-controller'",
            "message": "only the applier may grant to the effector or synthetic users or change generated RBAC"
          }
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "agent-bailiff",
