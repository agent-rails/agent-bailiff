    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "agent-bailiff",
          "bailiff.dev/generated": "true"
        },
        "name": "bailiff-scale-deployment"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConditions": [
          {
            "expression": "request.userInfo.username.startsWith('bailiff:')",
            "name": "synthetic-user"
          },
          {
            "expression": "request.userInfo.username.endsWith(':scale')",
            "name": "operation-identity"
          }
        ],
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                "apps"
              ],
              "apiVersions": [
                "*"
              ],
              "operations": [
                "UPDATE"
              ],
              "resources": [
                "deployments/scale"
              ]
            }
          ]
        },
        "validations": [
          {
            "expression": "has(object.spec.replicas) && object.spec.replicas >= 1 && object.spec.replicas <= 10",
            "message": "replicas must be between 1 and 10"
          }
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {
        "labels": {
