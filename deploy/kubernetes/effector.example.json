    {
      "apiVersion": "admissionregistration.k8s.io/v1",
      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "agent-bailiff",
          "bailiff.dev/generated": "true"
        },
        "name": "bailiff-effector-guard"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConditions": [
          {
            "expression": "request.userInfo.username.startsWith('bailiff:')",
            "name": "synthetic-user"
          }
        ],
        "matchConstraints": {
          "resourceRules": [
            {
              "apiGroups": [
                "*"
              ],
              "apiVersions": [
                "*"
              ],
              "operations": [
                "*"
              ],
              "resources": [
                "*/*"
              ]
            }
          ]
        },
        "validations": [
          {
            "expression": "has(request.userInfo.extra) && 'bailiff.dev/op-id' in request.userInfo.extra && size(request.userInfo.extra['bailiff.dev/op-id']) == 1 && request.userInfo.extra['bailiff.dev/op-id'][0].matches('^[A-Za-z0-9_-]{43}$')",
            "message": "a synthetic user request must carry exactly one valid op-id"
          },
          {
            "expression": "(request.resource.group == 'apps' && request.resource.resource == 'deployments' && request.subResource == 'scale' && request.operation == 'UPDATE' && request.userInfo.username.endsWith(':scale'))",
            "message": "synthetic users may write only through the catalog's write operations"
          },
          {
            "expression": "(request.userInfo.username.startsWith('bailiff:tenant-a:') && request.namespace in [\"staging\"])",
            "message": "synthetic users may write only in their tenant's namespaces"
          }
        ]
      }
    },
